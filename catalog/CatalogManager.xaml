<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="CatalogManagerWindow"
        Title="UHM Catalog Manager"
        Width="1260" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Language="fa-IR" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Background="#070A0F" Foreground="#F4F7F9" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#0D141C"/>
    <SolidColorBrush x:Key="Panel2" Color="#121B25"/>
    <SolidColorBrush x:Key="Line" Color="#293744"/>
    <SolidColorBrush x:Key="Text" Color="#F4F7F9"/>
    <SolidColorBrush x:Key="Muted" Color="#8D9AA8"/>
    <SolidColorBrush x:Key="Accent" Color="#DFFF32"/>
    <SolidColorBrush x:Key="Danger" Color="#FF5D68"/>
    <SolidColorBrush x:Key="Success" Color="#51E49A"/>
    <SolidColorBrush x:Key="Warning" Color="#FFA34B"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="1,0,1,6"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,14"/></Style>

    <Style x:Key="ButtonBase" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel2}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#1B2833"/><Setter TargetName="B" Property="BorderBrush" Value="#4A5B6B"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#090D0F"/><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><Border.Effect><DropShadowEffect Color="#A8C800" BlurRadius="15" ShadowDepth="0" Opacity="0.17"/></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#ECFF76"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.74"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#090F15"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="CaretBrush" Value="{StaticResource Accent}"/><Setter Property="SelectionBrush" Value="#65DFFF32"/><Setter Property="MinHeight" Value="39"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#4A5B6B"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#090F15"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="MinHeight" Value="39"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101820"/><Setter Property="Background" Value="#E9EDF0"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="39"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="4"/></Style>

    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}" Margin="2,0"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter TargetName="TabBorder" Property="Background" Value="#101821"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="TabBorder" Property="Background" Value="#141E27"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" CornerRadius="9" Background="#0A1016" BorderBrush="#1F2B35" BorderThickness="1" Padding="11"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#131E27"/><Setter TargetName="B" Property="BorderBrush" Value="#40515F"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#1B291E"/><Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="#23313D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.2"/></Setter.Value></Setter></Style>
  </Window.Resources>

  <Grid FlowDirection="LeftToRight">
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>

    <!-- Title bar -->
    <Border x:Name="TitleBar" Grid.Row="0" BorderBrush="#293744" BorderThickness="0,0,0,1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0C1219" Offset="0"/><GradientStop Color="#111A22" Offset="0.55"/><GradientStop Color="#0E150B" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid Margin="18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="BtnClose" Style="{StaticResource GhostButton}" Content="×" Foreground="{StaticResource Danger}" FontSize="22" Width="38" Height="36" Padding="0"/><Button x:Name="BtnMaximize" Style="{StaticResource GhostButton}" Content="□" Width="38" Height="36" Padding="0"/><Button x:Name="BtnMinimize" Style="{StaticResource GhostButton}" Content="—" Width="38" Height="36" Padding="0"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"><Border Width="35" Height="35" CornerRadius="10" Background="#20DFFF32" BorderBrush="#55DFFF32" BorderThickness="1"><TextBlock Text="C" Foreground="{StaticResource Accent}" FontWeight="Black" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,1,0,0"><TextBlock Text="UHM CATALOG MANAGER" FontSize="14" FontWeight="Bold"/><TextBlock Text="Native metadata authoring tool" Foreground="{StaticResource Muted}" FontSize="8"/></StackPanel></StackPanel>
        <Border Grid.Column="2" Background="#111A20" BorderBrush="#2C3A43" BorderThickness="1" CornerRadius="8" Padding="11,7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource Success}" Margin="0,0,7,0"/><TextBlock x:Name="HeaderCatalogVersion" Text="Catalog —" FontSize="9"/></StackPanel></Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- Existing records -->
      <Border Grid.Column="0" Style="{StaticResource Card}" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="مودهای موجود" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="برای ساخت رکورد مشابه، یک مورد را انتخاب کنید" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,5,0,13"/></StackPanel><TextBox x:Name="ExistingSearch" Grid.Row="1" ToolTip="جست‌وجوی رکوردهای موجود"/><ListBox x:Name="ExistingMods" Grid.Row="2" Margin="0,12,0,12" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><DockPanel><Border Width="27" Height="27" CornerRadius="7" Background="#1EDFFF32" Margin="0,0,9,0"><TextBlock Text="{Binding shortCategory}" Foreground="{StaticResource Accent}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="{Binding display}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding id}" Foreground="#627180" FontSize="8"/></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="3"><Button x:Name="BtnClone" Style="{StaticResource ButtonBase}" Content="ساخت از روی مورد انتخابی" Margin="0,0,0,7"/><Button x:Name="BtnReset" Style="{StaticResource GhostButton}" Content="فرم کاملاً جدید"/></StackPanel></Grid></Border>

      <!-- Editor -->
      <Border Grid.Column="2" Style="{StaticResource Card}" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10"><StackPanel><TextBlock Text="افزودن مود جدید" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="تمام ورودی‌ها پیش از ذخیره توسط همان Validator لانچر بررسی می‌شوند" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Left" Background="#16DFFF32" BorderBrush="#3BDFFF32" BorderThickness="1" CornerRadius="8" Padding="10,6"><TextBlock x:Name="FormModeBadge" Text="NEW RECORD" Foreground="{StaticResource Accent}" FontSize="8" FontWeight="Bold"/></Border></DockPanel>
        <TabControl x:Name="EditorTabs" Grid.Row="1">
          <!-- Basic -->
          <TabItem Header="۱  اطلاعات اصلی"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,8,12"><StackPanel>
            <TextBlock Text="شناسه و معرفی" Style="{StaticResource SectionTitle}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="نام انگلیسی *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ModName"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="نام فارسی *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ModNameFa"/></StackPanel></Grid>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="شناسه یکتا *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ModId" FlowDirection="LeftToRight"/></StackPanel><Button x:Name="BtnGenerateId" Grid.Column="1" Style="{StaticResource ButtonBase}" Content="ساخت ID" VerticalAlignment="Bottom" Margin="7,0,0,0"/><StackPanel Grid.Column="3"><TextBlock Text="سازنده *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="Author"/></StackPanel></Grid>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="دسته‌بندی *" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="Category" DisplayMemberPath="name" SelectedValuePath="id"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="نسخه مود *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="Version" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="تاریخ انتشار" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ReleaseDate" FlowDirection="LeftToRight"/></StackPanel></Grid>
            <TextBlock Text="توضیحات" Style="{StaticResource SectionTitle}" Margin="0,22,0,14"/>
            <TextBlock Text="توضیح کوتاه *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ShortDescription" MaxLength="220"/>
            <TextBlock Text="توضیح کامل *" Style="{StaticResource LabelStyle}" Margin="1,12,1,6"/><TextBox x:Name="Description" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="125"/>
          </StackPanel></ScrollViewer></TabItem>

          <!-- Download -->
          <TabItem Header="۲  دانلود و آرشیو"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,8,12"><StackPanel>
            <TextBlock Text="لینک‌های رسمی" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="صفحه رسمی سازنده *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="PageUrl" FlowDirection="LeftToRight"/>
            <TextBlock Text="لینک مستقیم دانلود HTTPS *" Style="{StaticResource LabelStyle}" Margin="1,12,1,6"/><TextBox x:Name="DownloadUrl" FlowDirection="LeftToRight"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0"><Button x:Name="BtnTestLinks" Style="{StaticResource ButtonBase}" Content="تست امن لینک‌ها"/><TextBlock x:Name="LinkTestStatus" Text="تست نشده" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center" Margin="12,0"/></StackPanel>
            <TextBlock Text="مشخصات فایل" Style="{StaticResource SectionTitle}" Margin="0,24,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="نوع آرشیو *" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="ArchiveType"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="حجم دقیق بایت *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="SizeBytes" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="حجم نمایشی" Style="{StaticResource LabelStyle}"/><TextBox x:Name="SizeText" FlowDirection="LeftToRight"/></StackPanel></Grid>
            <DockPanel Margin="0,12,0,0"><Button x:Name="BtnPickArchive" DockPanel.Dock="Left" Style="{StaticResource ButtonBase}" Content="انتخاب فایل برای Hash و حجم"/><TextBlock x:Name="ArchiveLocalStatus" Text="فایل مود در GitHub کپی نمی‌شود" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/></DockPanel>
            <TextBlock Text="SHA-256 (پیشنهاد اکید برای Production)" Style="{StaticResource LabelStyle}" Margin="1,12,1,6"/><TextBox x:Name="Sha256" FlowDirection="LeftToRight"/>
            <Border Background="#0A1016" BorderBrush="#25323D" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,15,0,0"><StackPanel><CheckBox x:Name="PasswordRequired" Content="آرشیو رمز دارد"/><TextBlock Text="رمز عمومی کاتالوگ" Style="{StaticResource LabelStyle}" Margin="1,9,1,6"/><PasswordBox x:Name="ArchivePassword"/></StackPanel></Border>
          </StackPanel></ScrollViewer></TabItem>

          <!-- Installation -->
          <TabItem Header="۳  نصب و سازگاری"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,8,12"><StackPanel>
            <TextBlock Text="روش نصب" Style="{StaticResource SectionTitle}"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="نوع نصب *" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="InstallType" DisplayMemberPath="name" SelectedValuePath="id"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="مسیر نصب نسبی *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="InstallRoot" FlowDirection="LeftToRight"/></StackPanel></Grid>
            <Border Background="#0A1016" BorderBrush="#25323D" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,16,0,0"><StackPanel><TextBlock Text="Content Shaders Patch" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><CheckBox x:Name="RequiresCsp" Content="نیازمند CSP"/><CheckBox x:Name="CspPreviewRequired" Content="نیازمند Preview"/><CheckBox x:Name="BlockInstall" Content="Block Install در ناسازگاری"/></WrapPanel><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="حداقل نسخه CSP" Style="{StaticResource LabelStyle}"/><TextBox x:Name="MinCspVersion" FlowDirection="LeftToRight"/></StackPanel></Grid></StackPanel></Border>
            <TextBlock Text="سازگاری" Style="{StaticResource SectionTitle}" Margin="0,22,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Pure" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="PureCompatibility"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Sol" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="SolCompatibility"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Content Manager" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="CmCompatibility"/></StackPanel></Grid>
            <TextBlock Text="وابستگی‌ها؛ هر مورد در یک خط" Style="{StaticResource LabelStyle}" Margin="1,16,1,6"/><TextBox x:Name="Dependencies" AcceptsReturn="True" Height="75" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="دستورالعمل نصب؛ هر مرحله در یک خط" Style="{StaticResource LabelStyle}" Margin="1,12,1,6"/><TextBox x:Name="InstallInstructions" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="مراحل فعال‌سازی بعد از نصب" Style="{StaticResource LabelStyle}" Margin="1,12,1,6"/><TextBox x:Name="ActivationSteps" AcceptsReturn="True" Height="85" VerticalScrollBarVisibility="Auto"/>
          </StackPanel></ScrollViewer></TabItem>

          <!-- Media -->
          <TabItem Header="۴  رسانه و انتشار"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,16,8,12"><StackPanel>
            <TextBlock Text="تصاویر" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="URL تصویر اصلی HTTPS *" Style="{StaticResource LabelStyle}"/><TextBox x:Name="ImageUrl" FlowDirection="LeftToRight"/>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="BtnPickImage" Grid.Column="0" Style="{StaticResource ButtonBase}" Content="انتخاب تصویر و کپی به Repository"/><Border Grid.Column="2" Height="96" Background="#090F15" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" ClipToBounds="True"><Grid><TextBlock Text="IMAGE PREVIEW" Foreground="#34424F" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="ImagePreview" Stretch="UniformToFill"/></Grid></Border></Grid>
            <TextBlock Text="Gallery URLs؛ هر URL در یک خط" Style="{StaticResource LabelStyle}" Margin="1,14,1,6"/><TextBox x:Name="GalleryUrls" AcceptsReturn="True" FlowDirection="LeftToRight" Height="95" VerticalScrollBarVisibility="Auto"/><Button x:Name="BtnPickGallery" Style="{StaticResource ButtonBase}" Content="انتخاب چند تصویر Gallery" HorizontalAlignment="Left" Margin="0,9,0,0"/>
            <TextBlock Text="Raw image base URL" Style="{StaticResource LabelStyle}" Margin="1,14,1,6"/><TextBox x:Name="ImageBaseUrl" FlowDirection="LeftToRight"/>
            <TextBlock Text="وضعیت انتشار" Style="{StaticResource SectionTitle}" Margin="0,23,0,14"/>
            <WrapPanel><CheckBox x:Name="Featured" Content="Featured"/><CheckBox x:Name="Verified" Content="Verified"/><CheckBox x:Name="Enabled" Content="Enabled"/><CheckBox x:Name="ConfirmRights" Content="مجوز لینک‌ها و تصاویر را بررسی کرده‌ام" Foreground="{StaticResource Warning}"/></WrapPanel>
            <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="نسخه جدید کاتالوگ" Style="{StaticResource LabelStyle}"/><TextBox x:Name="CatalogVersion" FlowDirection="LeftToRight"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="محبوبیت اولیه (۰ تا ۱۰۰)" Style="{StaticResource LabelStyle}"/><TextBox x:Name="Popularity" FlowDirection="LeftToRight"/></StackPanel></Grid>
          </StackPanel></ScrollViewer></TabItem>

          <!-- Preview -->
          <TabItem Header="۵  بازبینی JSON"><Grid Margin="4,16,8,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel><TextBlock Text="پیش‌نمایش رکورد نهایی" Style="{StaticResource SectionTitle}"/><TextBlock Text="Password در این پیش‌نمایش نمایش داده نمی‌شود؛ هنگام ذخیره در catalog.json قرار می‌گیرد." Foreground="{StaticResource Muted}" FontSize="9"/></StackPanel><Button x:Name="BtnBuildPreview" DockPanel.Dock="Left" Style="{StaticResource ButtonBase}" Content="ساخت پیش‌نمایش"/></DockPanel><TextBox x:Name="JsonPreview" Grid.Row="1" FontFamily="Consolas" FontSize="11" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FlowDirection="LeftToRight" TextWrapping="NoWrap"/></Grid></TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#0A1016" BorderBrush="#25323D" BorderThickness="1,1,1,0" CornerRadius="10,10,0,0" Padding="12" Margin="0,10,0,-18"><DockPanel><StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock x:Name="ValidationStatus" Text="فرم آماده تکمیل است" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/></StackPanel><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="BtnValidate" Style="{StaticResource ButtonBase}" Content="اعتبارسنجی کامل" Margin="4,0"/><Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Content="افزودن امن به catalog.json" Margin="4,0"/></StackPanel></DockPanel></Border>
      </Grid></Border>
    </Grid>

    <Border Grid.Row="2" Background="#090E13" BorderBrush="#24303A" BorderThickness="0,1,0,0"><DockPanel Margin="18,0"><TextBlock x:Name="FooterStatus" Text="آماده" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="فایل مود هرگز داخل GitHub کپی نمی‌شود" DockPanel.Dock="Left" Foreground="#566571" FontSize="8" VerticalAlignment="Center"/></DockPanel></Border>

    <Grid x:Name="BusyOverlay" Grid.RowSpan="3" Background="#C0020508" Visibility="Collapsed" Panel.ZIndex="100" FlowDirection="RightToLeft"><Border Width="390" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111A23" BorderBrush="#40515F" BorderThickness="1" CornerRadius="16" Padding="26"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.7"/></Border.Effect><StackPanel><ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource Accent}"/><TextBlock x:Name="BusyText" Text="در حال پردازش…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0"/></StackPanel></Border></Grid>
  </Grid>
</Window>
