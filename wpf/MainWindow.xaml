ton}" Content="×" Foreground="{StaticResource DangerBrush}" Padding="9,7" Margin="3" ToolTip="حذف رکورد صف"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Installed -->
        <Grid x:Name="PageInstalled" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
