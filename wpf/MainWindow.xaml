<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="UHM Launcher"
        Width="1360" Height="840" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Language="fa-IR" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Background="#070A0E" Foreground="#F3F6F8" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#070A0E"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0C1118"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#111821"/>
    <SolidColorBrush x:Key="Panel3Brush" Color="#18212B"/>
    <SolidColorBrush x:Key="LineBrush" Color="#26313D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F6F8"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B98A7"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#DFFF32"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1EDFFF32"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5864"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#50E395"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF9F43"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style TargetType="Button" x:Key="BaseButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Border" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#1B2631"/><Setter TargetName="Border" Property="BorderBrush" Value="#465566"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Opacity" Value="0.78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="#090D0F"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource GhostButton}">
      <Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Height" Value="49"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="17,0"/><Setter Property="FontSize" Value="13"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="#090E14"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,8"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#111820"/><Setter Property="Background" Value="#E9EDF0"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="9,6"/><Setter Property="MinHeight" Value="38"/>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="7"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/><Setter Property="Background" Value="#25303A"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Background" Value="#0F161E"/><Setter Property="BorderBrush" Value="#202B36"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="6"/>
    </Style>
    <Style x:Key="PanelCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="#202B36"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
    </Style>
  </Window.Resources>

  <Grid FlowDirection="LeftToRight">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="242"/></Grid.ColumnDefinitions>

    <!-- Native sidebar -->
    <Border Grid.Column="1" Background="#090D12" BorderBrush="#202A34" BorderThickness="1,0,0,0" FlowDirection="RightToLeft">
      <Grid Margin="18,26,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,8,36" FlowDirection="LeftToRight">
          <Border Width="42" Height="42" CornerRadius="11" Background="#1EDFFF32" BorderBrush="#55DFFF32" BorderThickness="1">
            <TextBlock Text="U" Foreground="{StaticResource AccentBrush}" FontWeight="Black" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,3,0,0"><TextBlock Text="UHM" FontSize="22" FontWeight="Black"/><TextBlock Text="NATIVE LAUNCHER" Foreground="{StaticResource MutedBrush}" FontSize="8"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Content="⌂     داشبورد"/>
          <Button x:Name="NavCatalog" Style="{StaticResource NavButton}" Content="▦     کاتالوگ مودها"/>
          <Button x:Name="NavQueue" Style="{StaticResource NavButton}" Content="⇩     صف دانلود و نصب"/>
          <Button x:Name="NavInstalled" Style="{StaticResource NavButton}" Content="✓     مودهای نصب‌شده"/>
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="⚙     تنظیمات"/>
        </StackPanel>
        <Border Grid.Row="2" Background="#0F161E" BorderBrush="#202B36" BorderThickness="1" CornerRadius="11" Padding="13">
          <StackPanel>
            <DockPanel><Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock Text="هسته محلی آماده" FontSize="11"/><TextBlock x:Name="SidebarVersion" Text="0.2.0" Foreground="{StaticResource MutedBrush}" FontSize="9" DockPanel.Dock="Left"/></DockPanel>
            <TextBlock Text="بدون مرورگر و بدون EXE اختصاصی" Foreground="#596777" FontSize="9" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Column="0" FlowDirection="RightToLeft">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#C9070A0E" BorderBrush="#202A34" BorderThickness="0,0,0,1" x:Name="TitleBar">
        <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
            <Button x:Name="BtnClose" Style="{StaticResource GhostButton}" Content="×" FontSize="22" Width="38" Height="36" Padding="0" Foreground="{StaticResource DangerBrush}"/>
            <Button x:Name="BtnMinimize" Style="{StaticResource GhostButton}" Content="—" Width="38" Height="36" Padding="0"/>
          </StackPanel>
          <Border Grid.Column="1" Width="500" Height="40" HorizontalAlignment="Center" Background="#0C1219" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
            <DockPanel Margin="12,0"><TextBlock Text="⌕" FontSize="22" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBox x:Name="GlobalSearch" BorderThickness="0" Background="Transparent" Padding="2" VerticalContentAlignment="Center" ToolTip="جست‌وجوی نام مود یا سازنده"/></DockPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#0E1719" BorderBrush="#254138" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionText" Text="کاتالوگ محلی" FontSize="10"/></StackPanel></Border>
            <Button x:Name="BtnRefresh" Style="{StaticResource BaseButton}" Content="↻  تازه‌سازی" Height="39" Padding="13,0"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="30,24,30,20">
        <!-- Dashboard -->
        <Grid x:Name="PageDashboard">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18"><TextBlock Text="مرکز کنترل" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="داشبورد راننده" FontSize="30" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="وضعیت مودها، بازی و دانلودها در یک نمای سریع" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
          <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,18">
            <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="کل مودهای فعال" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatTotalMods" Text="۰" FontSize="29" FontWeight="Bold" Margin="0,13,0,0"/><TextBlock Text="کاتالوگ تأییدشده" Foreground="#596777" FontSize="9" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="نصب‌شده‌ها" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatInstalled" Text="۰" FontSize="29" FontWeight="Bold" Margin="0,13,0,0"/><TextBlock Text="ثبت‌شده توسط UHM" Foreground="#596777" FontSize="9" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="دانلودهای فعال" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatActive" Text="۰" FontSize="29" FontWeight="Bold" Margin="0,13,0,0"/><TextBlock Text="Workerهای پس‌زمینه" Foreground="#596777" FontSize="9" Margin="0,7,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource StatCard}"><StackPanel><TextBlock Text="وضعیت Assetto Corsa" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="StatGame" Text="بررسی…" FontSize="20" FontWeight="Bold" Margin="0,15,0,0"/><TextBlock x:Name="StatGamePath" Text="" Foreground="#596777" FontSize="9" Margin="0,7,0,0"/></StackPanel></Border>
          </UniformGrid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><TextBlock Text="مودهای منتخب" FontSize="15" FontWeight="SemiBold"/><Button x:Name="BtnDashboardCatalog" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="نمایش همه ←"/></DockPanel><ListBox x:Name="FeaturedList" Grid.Row="1"/></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20"><StackPanel><TextBlock Text="سلامت سیستم" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/><Border Background="#0B1117" CornerRadius="9" Padding="12" Margin="0,4"><DockPanel><TextBlock Text="Steam"/><TextBlock x:Name="HealthSteam" Text="در حال بررسی" Foreground="{StaticResource WarningBrush}" DockPanel.Dock="Left"/></DockPanel></Border><Border Background="#0B1117" CornerRadius="9" Padding="12" Margin="0,4"><DockPanel><TextBlock Text="Assetto Corsa"/><TextBlock x:Name="HealthGame" Text="در حال بررسی" Foreground="{StaticResource WarningBrush}" DockPanel.Dock="Left"/></DockPanel></Border><Border Background="#0B1117" CornerRadius="9" Padding="12" Margin="0,4"><DockPanel><TextBlock Text="7-Zip"/><TextBlock x:Name="Health7Zip" Text="تست نشده" Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Left"/></DockPanel></Border><Button x:Name="BtnRunDiagnostics" Style="{StaticResource BaseButton}" Content="اجرای تست پیش‌نیازها" Margin="0,14,0,0"/></StackPanel></Border>
          </Grid>
        </Grid>

        <!-- Catalog -->
        <Grid x:Name="PageCatalog" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="MOD LIBRARY" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="کاتالوگ مودها" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="مود را انتخاب کنید، جزئیات را ببینید و با یک کلیک به صف بفرستید." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="CatalogCount" DockPanel.Dock="Left" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" Margin="20,0"/></DockPanel>
          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,15"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CatalogSearch" Grid.Column="0" Margin="0,0,8,0" ToolTip="جست‌وجوی مود"/><ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="0,0,8,0"/><ComboBox x:Name="SortFilter" Grid.Column="2" Margin="0,0,8,0"/><CheckBox x:Name="CatalogAutoInstall" Grid.Column="3" Content="نصب پس از دانلود" Margin="12,0"/></Grid><WrapPanel Margin="0,9,0,0"><TextBlock Text="فیلتر:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/><ComboBox x:Name="VersionFilter" Width="130" Margin="4,0"/><ComboBox x:Name="CspFilter" Width="130" Margin="4,0"/><ComboBox x:Name="PasswordFilter" Width="130" Margin="4,0"/><ComboBox x:Name="InstalledFilter" Width="140" Margin="4,0"/></WrapPanel></StackPanel></Border>
          <ListBox x:Name="CatalogList" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate>
              <Border Width="276" Height="230" Margin="7" Background="#0D141C" BorderBrush="#222E39" BorderThickness="1" CornerRadius="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <Border Background="#17232D" CornerRadius="13,13,0,0"><Grid><TextBlock Text="UHM" Foreground="#24DFFF32" FontSize="37" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding image}" Stretch="UniformToFill" Opacity="0.58"/><Border Background="#DFFF32" CornerRadius="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Padding="7,3"><TextBlock Text="{Binding categoryFa}" Foreground="#0A0E10" FontSize="8" FontWeight="Bold"/></Border></Grid></Border>
                  <Grid Grid.Row="1" Margin="15,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding nameFa}" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="{Binding authorLine}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,6,0,0"/><TextBlock Grid.Row="2" Text="{Binding shortDescription}" Foreground="#8794A2" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Margin="0,10,0,8" MaxHeight="38"/><DockPanel Grid.Row="3"><TextBlock Text="{Binding specLine}" Foreground="#627181" FontSize="9" VerticalAlignment="Center"/><Button x:Name="CatalogOpenButton" Tag="{Binding id}" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="جزئیات و نصب" Padding="11,6" FontSize="9"/></DockPanel></Grid>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Queue -->
        <Grid x:Name="PageQueue" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18"><TextBlock Text="TRANSFER CENTER" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="صف دانلود و نصب" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="دانلودها در Worker پس‌زمینه اجرا می‌شوند؛ بستن برنامه فایل ناقص را حذف نمی‌کند." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
          <ListBox x:Name="QueueList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate><Border Background="#0D141C" BorderBrush="#222E39" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="0" Width="50" Height="50" CornerRadius="10" Background="#1A2731"><TextBlock Text="{Binding initials}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="{Binding nameFa}" FontWeight="SemiBold"/><TextBlock Text="{Binding versionLine}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0"><DockPanel Margin="0,0,0,7"><TextBlock Text="{Binding statusFa}" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="{Binding progressText}" DockPanel.Dock="Left" Foreground="{StaticResource MutedBrush}" FontSize="9"/></DockPanel><ProgressBar Value="{Binding progress}" Maximum="100"/><DockPanel Margin="0,7,0,0"><TextBlock Text="{Binding transferLine}" Foreground="#647282" FontSize="8"/><TextBlock Text="{Binding error}" DockPanel.Dock="Left" Foreground="{StaticResource DangerBrush}" FontSize="8" MaxWidth="260"/></DockPanel></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="QueuePrimaryButton" Tag="{Binding id}" Style="{StaticResource PrimaryButton}" Content="{Binding primaryLabel}" Padding="12,7" Margin="3"/><Button x:Name="QueueCancelButton" Tag="{Binding id}" Style="{StaticResource BaseButton}" Content="لغو" Padding="10,7" Margin="3"/><Button x:Name="QueueRemoveButton" Tag="{Binding id}" Style="{StaticResource GhostButton}" Content="×" Foreground="{StaticResource DangerBrush}" Padding="9,7" Margin="3"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Installed -->
        <Grid x:Name="PageInstalled" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,0,18"><TextBlock Text="LOCAL LIBRARY" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="مودهای نصب‌شده" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="حذف مود در این نسخه وجود ندارد؛ این صفحه فقط Manifest نصب‌های UHM را نمایش می‌دهد." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
          <DataGrid x:Name="InstalledGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="#0C1118" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}" RowBackground="#0C1118" AlternatingRowBackground="#101720" HorizontalGridLinesBrush="#202A34">
            <DataGrid.Columns><DataGridTextColumn Header="نام مود" Binding="{Binding nameFa}" Width="1.4*"/><DataGridTextColumn Header="نسخه" Binding="{Binding installedVersion}" Width="0.5*"/><DataGridTextColumn Header="تاریخ نصب" Binding="{Binding installedDate}" Width="0.8*"/><DataGridTextColumn Header="تعداد فایل" Binding="{Binding fileCount}" Width="0.5*"/><DataGridTextColumn Header="مسیر بازی" Binding="{Binding gamePath}" Width="2*"/></DataGrid.Columns>
          </DataGrid>
        </Grid>

        <!-- Settings -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="CONFIGURATION" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="تنظیمات لانچر" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="مسیر بازی و رفتار دانلود را بدون ویرایش فایل تنظیم کنید." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelCard}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="مسیرهای Assetto Corsa" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="مسیر باید شامل AssettoCorsa.exe و content/cars و content/tracks باشد." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,14"/><ComboBox x:Name="SettingsDefaultPath" DisplayMemberPath="display" SelectedValuePath="id"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NewPathName" Grid.Column="0" Margin="0,0,8,0" ToolTip="نام مسیر"/><TextBox x:Name="NewPathValue" Grid.Column="1" Margin="0,0,8,0" FlowDirection="LeftToRight" ToolTip="مسیر پوشه بازی"/><Button x:Name="BtnBrowseGame" Grid.Column="2" Style="{StaticResource BaseButton}" Content="انتخاب پوشه"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0"><Button x:Name="BtnAddPath" Style="{StaticResource PrimaryButton}" Content="افزودن مسیر معتبر"/><Button x:Name="BtnRemovePath" Style="{StaticResource BaseButton}" Content="حذف از فهرست" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
                <Border Style="{StaticResource PanelCard}" Padding="20"><StackPanel><TextBlock Text="دانلود" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="پوشه فایل‌های دانلودشده و تعداد Workerها" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DownloadDirectory" Grid.Column="0" FlowDirection="LeftToRight" Margin="0,0,8,0"/><Button x:Name="BtnBrowseDownloads" Grid.Column="1" Style="{StaticResource BaseButton}" Content="انتخاب"/></Grid><DockPanel Margin="0,14,0,0"><TextBlock Text="حداکثر دانلود هم‌زمان" VerticalAlignment="Center"/><ComboBox x:Name="MaxDownloads" Width="110" DockPanel.Dock="Left"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox></DockPanel><CheckBox x:Name="CacheEnabled" Content="Cache کاتالوگ و تصاویر فعال باشد" Margin="0,15,0,0"/><Button x:Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Content="ذخیره تنظیمات" HorizontalAlignment="Left" Margin="0,17,0,0"/></StackPanel></Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PanelCard}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="آزمایش پیش‌نیازها" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><Button x:Name="BtnTestSteam" Style="{StaticResource BaseButton}" Content="تست Steam و Libraryها" Margin="0,4"/><Button x:Name="BtnTest7Zip" Style="{StaticResource BaseButton}" Content="تست 7-Zip" Margin="0,4"/><Button x:Name="BtnClearCache" Style="{StaticResource BaseButton}" Content="پاک‌کردن Cache با تأیید" Foreground="{StaticResource DangerBrush}" Margin="0,4"/></StackPanel></Border>
                <Border Style="{StaticResource PanelCard}" Padding="20"><StackPanel HorizontalAlignment="Stretch"><TextBlock Text="UHM NATIVE" FontSize="21" FontWeight="Black" HorizontalAlignment="Center"/><TextBlock Text="PowerShell + WPF / XAML" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,18"/><DockPanel Margin="0,5"><TextBlock Text="نسخه برنامه" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="0.2.0" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="نسخه کاتالوگ" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SettingsCatalogVersion" Text="—" DockPanel.Dock="Left"/></DockPanel><TextBlock Text="رابط اصلی HTML نیست و هیچ مرورگری برای اجرای نسخه Native باز نمی‌شود." Foreground="#657382" FontSize="9" TextWrapping="Wrap" Margin="0,16,0,0"/></StackPanel></Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="2" Background="#090D12" BorderBrush="#202A34" BorderThickness="0,1,0,0" FlowDirection="RightToLeft">
        <DockPanel Margin="16,0"><TextBlock x:Name="StatusText" Text="آماده" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center"/><TextBlock x:Name="StatusQueue" Text="صف خالی" DockPanel.Dock="Left" Foreground="#596777" FontSize="9" VerticalAlignment="Center"/></DockPanel>
      </Border>
    </Grid>

    <!-- Mod details overlay -->
    <Grid x:Name="DetailsOverlay" Grid.ColumnSpan="2" Background="#D9020508" Visibility="Collapsed" Panel.ZIndex="50" FlowDirection="RightToLeft">
      <Border Width="780" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#0D141C" BorderBrush="#34424F" BorderThickness="1" CornerRadius="18" Padding="26">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button x:Name="BtnCloseDetails" Style="{StaticResource GhostButton}" Content="×" FontSize="22" DockPanel.Dock="Left"/><StackPanel><TextBlock x:Name="DetailCategory" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock x:Name="DetailName" FontSize="27" FontWeight="Bold" Margin="0,6,0,0"/><TextBlock x:Name="DetailAuthor" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel></DockPanel><ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="درباره مود" FontWeight="SemiBold"/><TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="22" Margin="0,10,0,18"/><TextBlock Text="دستورالعمل و وابستگی‌ها" FontWeight="SemiBold"/><TextBlock x:Name="DetailInstructions" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="21" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="2"><Border Background="#091016" CornerRadius="11" Padding="14"><StackPanel><DockPanel Margin="0,5"><TextBlock Text="نسخه" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailVersion" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="حجم" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailSize" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="آرشیو" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailArchive" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="CSP" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailCsp" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="مسیر نصب" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailInstallRoot" DockPanel.Dock="Left" MaxWidth="180"/></DockPanel></StackPanel></Border><TextBlock Text="مقصد نصب" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,16,0,7"/><ComboBox x:Name="DetailTargetPath" DisplayMemberPath="display" SelectedValuePath="id"/><CheckBox x:Name="DetailAutoInstall" Content="پس از دانلود نصب شود" Margin="0,13,0,0"/></StackPanel></Grid></ScrollViewer><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BtnOfficialPage" Grid.Column="0" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="بازکردن صفحه رسمی ↗"/><Button x:Name="BtnDetailDownload" Grid.Column="1" Style="{StaticResource BaseButton}" Content="فقط دانلود" Margin="6,0"/><Button x:Name="BtnDetailInstall" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="دانلود و نصب" Margin="6,0"/></Grid></Grid>
      </Border>
    </Grid>

    <!-- Busy overlay -->
    <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#B0020406" Visibility="Collapsed" Panel.ZIndex="100" FlowDirection="RightToLeft">
      <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#101820" BorderBrush="#34424F" BorderThickness="1" CornerRadius="15" Padding="26"><StackPanel><ProgressBar IsIndeterminate="True" Height="5"/><TextBlock x:Name="BusyTitle" Text="در حال پردازش…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,19,0,0"/><TextBlock x:Name="BusyMessage" Text="لطفاً پنجره را نبندید." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
  </Grid>
</Window>
