          <Grid Grid.Row="1"><Border Style="{StaticResource PanelCard}" ClipToBounds="True"><DataGrid x:Name="InstalledGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Background="#0C1118" Foreground="{StaticResource TextBrush}" BorderThickness="0" RowBackground="#0C1118" AlternatingRowBackground="#101720" AlternationCount="2" RowHeaderWidth="0">
            <DataGrid.Columns><DataGridTextColumn Header="نام مود" Binding="{Binding nameFa}" Width="1.4*"/><DataGridTextColumn Header="نسخه" Binding="{Binding installedVersion}" Width="0.5*"/><DataGridTextColumn Header="تاریخ نصب" Binding="{Binding installedDate}" Width="0.8*"/><DataGridTextColumn Header="تعداد فایل" Binding="{Binding fileCount}" Width="0.5*"/><DataGridTextColumn Header="مسیر بازی" Binding="{Binding gamePath}" Width="2*"/></DataGrid.Columns>
          </DataGrid></Border><Border x:Name="InstalledEmptyState" Background="#0D131B" BorderBrush="#263442" BorderThickness="1" CornerRadius="14" Padding="35"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="58" Height="58" CornerRadius="17" Background="#2051E49A"><TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="هنوز مودی نصب نشده است" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/><TextBlock Text="پس از اولین نصب، Manifest مود در این صفحه نمایش داده می‌شود" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border></Grid>
        </Grid>

