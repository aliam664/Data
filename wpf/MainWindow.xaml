<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="UHM Launcher"
        Width="1360" Height="840" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Language="fa-IR" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Background="#070A0E" Foreground="#F3F6F8" FontFamily="Segoe UI">
  <Window.Resources>
    <!-- Design tokens -->
    <SolidColorBrush x:Key="BgBrush" Color="#070A0F"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0D131B"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#121A24"/>
    <SolidColorBrush x:Key="Panel3Brush" Color="#192430"/>
    <SolidColorBrush x:Key="LineBrush" Color="#263442"/>
    <SolidColorBrush x:Key="LineBrightBrush" Color="#3B4C5C"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7F9"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8D9AA8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#DFFF32"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#ECFF76"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#20DFFF32"/>
    <SolidColorBrush x:Key="CyanBrush" Color="#48D7FF"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5D68"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#51E49A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFA34B"/>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#18242E" Offset="0"/>
      <GradientStop Color="#101820" Offset="0.5"/>
      <GradientStop Color="#16200D" Offset="1"/>
    </LinearGradientBrush>

    <!-- Typography -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>
    <Style x:Key="PageEyebrow" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="29"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style x:Key="PageDescription" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- Buttons -->
    <Style TargetType="Button" x:Key="BaseButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#1A2530"/><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource LineBrightBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton">
      <Setter Property="Foreground" Value="#090D0F"/>
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="17,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="PrimaryBorder" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <Border.Effect><DropShadowEffect Color="#A7C800" BlurRadius="16" ShadowDepth="0" Opacity="0.16"/></Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBorder" Property="Background" Value="{StaticResource AccentHoverBrush}"/><Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.74"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="GhostButton" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style TargetType="Button" x:Key="NavButton" BasedOn="{StaticResource GhostButton}">
      <Setter Property="HorizontalContentAlignment" Value="Right"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="Padding" Value="17,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Text entry -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#090E14"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="SelectionBrush" Value="#70DFFF32"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="TextBorder" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="{StaticResource LineBrightBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="TextBorder" Property="Background" Value="#0C131A"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBorder" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Native dark combo boxes -->
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#0C131A"/>
      <Setter Property="Padding" Value="11,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#1C2933"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#26361A"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#090E14"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="MinHeight" Value="39"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ComboBorder" CornerRadius="9" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1">
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions><Path Grid.Column="1" Width="8" Height="5" Stretch="Fill" Fill="{StaticResource MutedBrush}" Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource LineBrightBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter Margin="12,3,38,3" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Right" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border MinWidth="180" MaxHeight="320" Margin="0,5,0,0" Background="#0C131A" BorderBrush="{StaticResource LineBrightBrush}" BorderThickness="1" CornerRadius="9" Padding="4">
                  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.55"/></Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False"><Setter TargetName="PART_Popup" Property="MinHeight" Value="38"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#F0121921"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrightBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/>
    </Style>

    <!-- Collections and progress -->
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CatalogListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Grid><ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer><Border x:Name="EmptyState" Background="#090F15" BorderBrush="#263442" BorderThickness="1" CornerRadius="14" Padding="35" Margin="8"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="58" Height="58" CornerRadius="17" Background="#1EDFFF32"><TextBlock Text="⌕" Foreground="{StaticResource AccentBrush}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="مودی با این فیلتر پیدا نشد" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/><TextBlock Text="عبارت جست‌وجو یا فیلترها را تغییر دهید" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border></Grid><ControlTemplate.Triggers><Trigger Property="HasItems" Value="True"><Setter TargetName="EmptyState" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QueueListStyle" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Grid><ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter/></ScrollViewer><Border x:Name="EmptyState" Background="#090F15" BorderBrush="#263442" BorderThickness="1" CornerRadius="14" Padding="35"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="58" Height="58" CornerRadius="17" Background="#2048D7FF"><TextBlock Text="⇣" Foreground="{StaticResource CyanBrush}" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="صف دانلود خالی است" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0"/><TextBlock Text="از کاتالوگ یک مود را برای دانلود انتخاب کنید" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Center" Margin="0,7,0,0"/></StackPanel></Border></Grid><ControlTemplate.Triggers><Trigger Property="HasItems" Value="True"><Setter TargetName="EmptyState" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="7"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="#25303A"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="ProgressRoot"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="4"><Border.Effect><DropShadowEffect Color="#DFFF32" BlurRadius="8" ShadowDepth="0" Opacity="0.28"/></Border.Effect></Border></Grid>
            <ControlTemplate.Triggers><Trigger Property="IsIndeterminate" Value="True"><Setter TargetName="PART_Indicator" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="PART_Indicator" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Data grid -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#111A23"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="10"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#0D131B"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="BorderBrush" Value="#1E2A35"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="MinHeight" Value="48"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#131E28"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1B2A20"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>

    <!-- Card surfaces -->
    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Background" Value="#101821"/><Setter Property="BorderBrush" Value="#23303C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="6"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.20"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="PanelCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="#222E3A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="6" Opacity="0.18"/></Setter.Value></Setter>
    </Style>
    <Style x:Key="CatalogCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
      <Setter Property="Width" Value="292"/><Setter Property="Height" Value="292"/><Setter Property="Margin" Value="8"/><Setter Property="Background" Value="#0D141C"/><Setter Property="BorderBrush" Value="#24313D"/><Setter Property="CornerRadius" Value="15"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#70DFFF32"/><Setter Property="Background" Value="#101923"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#A6C800" BlurRadius="22" ShadowDepth="4" Opacity="0.16"/></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid FlowDirection="LeftToRight">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="242"/></Grid.ColumnDefinitions>

    <!-- Native sidebar -->
    <Border Grid.Column="1" BorderBrush="#273440" BorderThickness="1,0,0,0" FlowDirection="RightToLeft">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0C1219" Offset="0"/><GradientStop Color="#080C11" Offset="0.62"/><GradientStop Color="#0A100C" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid Margin="18,24,18,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,8,31" FlowDirection="LeftToRight">
          <Border Width="48" Height="48" CornerRadius="13" Background="#22DFFF32" BorderBrush="#68DFFF32" BorderThickness="1">
            <Border.Effect><DropShadowEffect Color="#DFFF32" BlurRadius="18" ShadowDepth="0" Opacity="0.20"/></Border.Effect>
            <Grid><TextBlock Text="U" Foreground="{StaticResource AccentBrush}" FontWeight="Black" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/><Rectangle Width="20" Height="2" Fill="{StaticResource AccentBrush}" VerticalAlignment="Bottom" Margin="0,0,0,7"/></Grid>
          </Border>
          <StackPanel Margin="13,4,0,0"><TextBlock Text="UHM" FontSize="23" FontWeight="Black"/><TextBlock Text="ASSETTO MOD CONTROL" Foreground="{StaticResource MutedBrush}" FontSize="8" Margin="0,3,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="منوی اصلی" Foreground="#556371" FontSize="9" Margin="14,0,14,10"/>
          <Button x:Name="NavDashboard" Style="{StaticResource NavButton}"><DockPanel><Border Width="29" Height="29" CornerRadius="8" Background="#111A23" Margin="0,0,11,0"><TextBlock Text="◈" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="داشبورد" VerticalAlignment="Center"/></DockPanel></Button>
          <Button x:Name="NavCatalog" Style="{StaticResource NavButton}"><DockPanel><Border Width="29" Height="29" CornerRadius="8" Background="#111A23" Margin="0,0,11,0"><TextBlock Text="▦" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="کاتالوگ مودها" VerticalAlignment="Center"/></DockPanel></Button>
          <Button x:Name="NavQueue" Style="{StaticResource NavButton}"><DockPanel><Border Width="29" Height="29" CornerRadius="8" Background="#111A23" Margin="0,0,11,0"><TextBlock Text="⇣" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="صف دانلود و نصب" VerticalAlignment="Center"/></DockPanel></Button>
          <Button x:Name="NavInstalled" Style="{StaticResource NavButton}"><DockPanel><Border Width="29" Height="29" CornerRadius="8" Background="#111A23" Margin="0,0,11,0"><TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="مودهای نصب‌شده" VerticalAlignment="Center"/></DockPanel></Button>
          <Button x:Name="NavSettings" Style="{StaticResource NavButton}"><DockPanel><Border Width="29" Height="29" CornerRadius="8" Background="#111A23" Margin="0,0,11,0"><TextBlock Text="⚙" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="تنظیمات" VerticalAlignment="Center"/></DockPanel></Button>
        </StackPanel>
        <Border Grid.Row="2" BorderBrush="#293744" BorderThickness="1" CornerRadius="12" Padding="14">
          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#121B24" Offset="0"/><GradientStop Color="#10170F" Offset="1"/></LinearGradientBrush></Border.Background>
          <StackPanel>
            <DockPanel><Grid Width="18" Height="18" Margin="0,0,8,0"><Ellipse Fill="#2051E49A"/><Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}"/></Grid><TextBlock Text="Native Engine" FontSize="11" FontWeight="SemiBold"/><Border DockPanel.Dock="Left" Background="#18FFFFFF" CornerRadius="6" Padding="7,3"><TextBlock x:Name="SidebarVersion" Text="v0.2.0" Foreground="{StaticResource MutedBrush}" FontSize="8"/></Border></DockPanel>
            <TextBlock Text="هسته محلی آماده و امن است" Foreground="#6C7A88" FontSize="9" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Column="0" FlowDirection="RightToLeft">
      <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Border Grid.Row="0" BorderBrush="#263440" BorderThickness="0,0,0,1" x:Name="TitleBar"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F0090D12" Offset="0"/><GradientStop Color="#F00D1319" Offset="0.55"/><GradientStop Color="#F00B100D" Offset="1"/></LinearGradientBrush></Border.Background>
        <Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
            <Button x:Name="BtnClose" Style="{StaticResource GhostButton}" Content="×" FontSize="22" Width="38" Height="36" Padding="0" Foreground="{StaticResource DangerBrush}" ToolTip="بستن"/>
            <Button x:Name="BtnMaximize" Style="{StaticResource GhostButton}" Content="□" FontSize="15" Width="38" Height="36" Padding="0" ToolTip="بزرگ‌نمایی"/>
            <Button x:Name="BtnMinimize" Style="{StaticResource GhostButton}" Content="—" Width="38" Height="36" Padding="0" ToolTip="کمینه"/>
          </StackPanel>
          <Border Grid.Column="1" Width="440" Height="40" HorizontalAlignment="Center" Background="#0C1219" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10">
            <DockPanel Margin="12,0"><TextBlock Text="⌕" FontSize="22" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/><TextBox x:Name="GlobalSearch" BorderThickness="0" Background="Transparent" Padding="2" VerticalContentAlignment="Center" ToolTip="جست‌وجوی نام مود یا سازنده"/></DockPanel>
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Background="#0E1719" BorderBrush="#254138" BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0"/><TextBlock x:Name="ConnectionText" Text="کاتالوگ محلی" FontSize="10"/></StackPanel></Border>
            <Button x:Name="BtnRefresh" Style="{StaticResource BaseButton}" Content="↻  تازه‌سازی" Height="39" Padding="13,0"/>
          </StackPanel>
        </Grid>
      </Border>

