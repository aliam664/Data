                  <Grid Grid.Row="1" Margin="16,11,16,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding nameFa}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding cspLine}" DockPanel.Dock="Left" Foreground="{StaticResource WarningBrush}" FontSize="8" VerticalAlignment="Center"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding authorLine}" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,5,0,0"/><TextBlock Grid.Row="2" Text="{Binding shortDescription}" Foreground="#91A0AE" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="17" Margin="0,9,0,8" MaxHeight="44"/><DockPanel Grid.Row="3" LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding specLine}" Foreground="#687786" FontSize="8"/><Border Width="4" Height="4" Background="#536270" CornerRadius="2" Margin="8,0"/><TextBlock Text="{Binding installState}" Foreground="{StaticResource SuccessBrush}" FontSize="8"/></StackPanel><Button x:Name="CatalogOpenButton" Tag="{Binding id}" DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="مشاهده و نصب" Padding="12,6" FontSize="9"/></DockPanel></Grid>
                </Grid>
              </Border>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </Grid>

