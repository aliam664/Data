          <StackPanel>
            <TextBlock Text="CONFIGURATION" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="تنظیمات لانچر" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="مسیر بازی و رفتار دانلود را بدون ویرایش فایل تنظیم کنید." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Style="{StaticResource PanelCard}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="مسیرهای Assetto Corsa" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="مسیر باید شامل AssettoCorsa.exe و content/cars و content/tracks باشد." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,14"/><ComboBox x:Name="SettingsDefaultPath" DisplayMemberPath="display" SelectedValuePath="id"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NewPathName" Grid.Column="0" Margin="0,0,8,0" ToolTip="نام مسیر"/><TextBox x:Name="NewPathValue" Grid.Column="1" Margin="0,0,8,0" FlowDirection="LeftToRight" ToolTip="مسیر پوشه بازی"/><Button x:Name="BtnBrowseGame" Grid.Column="2" Style="{StaticResource BaseButton}" Content="انتخاب پوشه"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0"><Button x:Name="BtnAddPath" Style="{StaticResource PrimaryButton}" Content="افزودن مسیر معتبر"/><Button x:Name="BtnRemovePath" Style="{StaticResource BaseButton}" Content="حذف از فهرست" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
                <Border Style="{StaticResource PanelCard}" Padding="20"><StackPanel><TextBlock Text="دانلود" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="پوشه فایل‌های دانلودشده و تعداد Workerها" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="DownloadDirectory" Grid.Column="0" FlowDirection="LeftToRight" Margin="0,0,8,0"/><Button x:Name="BtnBrowseDownloads" Grid.Column="1" Style="{StaticResource BaseButton}" Content="انتخاب"/></Grid><DockPanel Margin="0,14,0,0"><TextBlock Text="حداکثر دانلود هم‌زمان" VerticalAlignment="Center"/><ComboBox x:Name="MaxDownloads" Width="110" DockPanel.Dock="Left"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/></ComboBox></DockPanel><CheckBox x:Name="CacheEnabled" Content="Cache کاتالوگ و تصاویر فعال باشد" Margin="0,15,0,0"/><Button x:Name="BtnSaveSettings" Style="{StaticResource PrimaryButton}" Content="ذخیره تنظیمات" HorizontalAlignment="Left" Margin="0,17,0,0"/></StackPanel></Border>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Border Style="{StaticResource PanelCard}" Padding="20" Margin="0,0,0,14"><StackPanel><TextBlock Text="آزمایش پیش‌نیازها" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/><Button x:Name="BtnTestSteam" Style="{StaticResource BaseButton}" Content="تست Steam و Libraryها" Margin="0,4"/><Button x:Name="BtnTest7Zip" Style="{StaticResource BaseButton}" Content="تست 7-Zip" Margin="0,4"/><Button x:Name="BtnClearCache" Style="{StaticResource BaseButton}" Content="پاک‌کردن Cache با تأیید" Foreground="{StaticResource DangerBrush}" Margin="0,4"/></StackPanel></Border>
