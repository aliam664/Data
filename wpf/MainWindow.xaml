            <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource SuccessBrush}" CornerRadius="3"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><DockPanel><TextBlock Text="مودهای نصب‌شده" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Border DockPanel.Dock="Left" Width="30" Height="30" Background="#2051E49A" CornerRadius="8"><TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DockPanel><TextBlock x:Name="StatInstalled" Text="۰" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="با Manifest نصب" Foreground="#5F6E7C" FontSize="8" Margin="0,5,0,0"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource CyanBrush}" CornerRadius="3"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><DockPanel><TextBlock Text="دانلودهای فعال" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Border DockPanel.Dock="Left" Width="30" Height="30" Background="#2048D7FF" CornerRadius="8"><TextBlock Text="⇣" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DockPanel><TextBlock x:Name="StatActive" Text="۰" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Workerهای پس‌زمینه" Foreground="#5F6E7C" FontSize="8" Margin="0,5,0,0"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource StatCard}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{StaticResource WarningBrush}" CornerRadius="3"/><StackPanel Grid.Column="1" Margin="14,0,0,0"><DockPanel><TextBlock Text="Assetto Corsa" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/><Border DockPanel.Dock="Left" Width="30" Height="30" Background="#20FFA34B" CornerRadius="8"><TextBlock Text="AC" Foreground="{StaticResource WarningBrush}" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DockPanel><TextBlock x:Name="StatGame" Text="بررسی…" FontSize="17" FontWeight="Bold" Margin="0,11,0,0"/><TextBlock x:Name="StatGamePath" Text="" Foreground="#5F6E7C" FontSize="8" Margin="0,6,0,0"/></StackPanel></Grid></Border>
          </UniformGrid>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelCard}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="مودهای منتخب" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="پیشنهادهای برجسته کاتالوگ" Foreground="#657482" FontSize="8" Margin="0,4,0,0"/></StackPanel><Button x:Name="BtnDashboardCatalog" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="نمایش همه  ←"/></DockPanel><ListBox x:Name="FeaturedList" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Border Background="#0A1016" BorderBrush="#1F2B35" BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,0,0,6"><DockPanel><Border Width="26" Height="26" CornerRadius="7" Background="#1EDFFF32" Margin="0,0,10,0"><TextBlock Text="★" Foreground="{StaticResource AccentBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding display}" VerticalAlignment="Center" FontSize="10"/><TextBlock Text="←" DockPanel.Dock="Left" Foreground="#52616F" VerticalAlignment="Center"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="20"><StackPanel><TextBlock Text="سلامت سیستم" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="بررسی سریع پیش‌نیازهای نصب" Foreground="#657482" FontSize="8" Margin="0,4,0,12"/><Border Background="#0A1016" BorderBrush="#1E2933" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,4"><DockPanel><Border Width="25" Height="25" CornerRadius="7" Background="#1B2430" Margin="0,0,9,0"><TextBlock Text="S" Foreground="{StaticResource CyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Text="Steam" VerticalAlignment="Center"/><TextBlock x:Name="HealthSteam" Text="در حال بررسی" Foreground="{StaticResource WarningBrush}" FontSize="9" DockPanel.Dock="Left" VerticalAlignment="Center"/></DockPanel></Border><Border Background="#0A1016" BorderBrush="#1E2933" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,4"><DockPanel><Border Width="25" Height="25" CornerRadius="7" Background="#1B2430" Margin="0,0,9,0"><TextBlock Text="AC" Foreground="{StaticResource AccentBrush}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Text="Assetto Corsa" VerticalAlignment="Center"/><TextBlock x:Name="HealthGame" Text="در حال بررسی" Foreground="{StaticResource WarningBrush}" FontSize="9" DockPanel.Dock="Left" VerticalAlignment="Center"/></DockPanel></Border><Border Background="#0A1016" BorderBrush="#1E2933" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,4"><DockPanel><Border Width="25" Height="25" CornerRadius="7" Background="#1B2430" Margin="0,0,9,0"><TextBlock Text="7z" Foreground="{StaticResource MutedBrush}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Text="7-Zip" VerticalAlignment="Center"/><TextBlock x:Name="Health7Zip" Text="تست نشده" Foreground="{StaticResource MutedBrush}" FontSize="9" DockPanel.Dock="Left" VerticalAlignment="Center"/></DockPanel></Border><Button x:Name="BtnRunDiagnostics" Style="{StaticResource BaseButton}" Content="اجرای تست پیش‌نیازها" Margin="0,12,0,0"/></StackPanel></Border>
          </Grid>
        </Grid>

        <!-- Catalog -->
        <Grid x:Name="PageCatalog" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,18"><StackPanel><TextBlock Text="MOD LIBRARY" Foreground="{StaticResource AccentBrush}" FontSize="10"/><TextBlock Text="کاتالوگ مودها" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="مود را انتخاب کنید، جزئیات را ببینید و با یک کلیک به صف بفرستید." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel><TextBlock x:Name="CatalogCount" DockPanel.Dock="Left" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" Margin="20,0"/></DockPanel>
          <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,15"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CatalogSearch" Grid.Column="0" Margin="0,0,8,0" ToolTip="جست‌وجوی مود"/><ComboBox x:Name="CategoryFilter" Grid.Column="1" Margin="0,0,8,0"/><ComboBox x:Name="SortFilter" Grid.Column="2" Margin="0,0,8,0"/><CheckBox x:Name="CatalogAutoInstall" Grid.Column="3" Content="نصب پس از دانلود" Margin="12,0"/></Grid><WrapPanel Margin="0,9,0,0"><TextBlock Text="فیلتر:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="4,0,8,0"/><ComboBox x:Name="VersionFilter" Width="130" Margin="4,0"/><ComboBox x:Name="CspFilter" Width="130" Margin="4,0"/><ComboBox x:Name="PasswordFilter" Width="130" Margin="4,0"/><ComboBox x:Name="InstalledFilter" Width="140" Margin="4,0"/></WrapPanel></StackPanel></Border>
          <ListBox x:Name="CatalogList" Grid.Row="2" Style="{StaticResource CatalogListStyle}" ScrollViewer.VerticalScrollBarVisibility="Auto">
