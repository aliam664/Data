    <Grid x:Name="DetailsOverlay" Grid.ColumnSpan="2" Background="#D9020508" Visibility="Collapsed" Panel.ZIndex="50" FlowDirection="RightToLeft">
      <Border Width="820" MaxHeight="720" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#0D141C" BorderBrush="#455563" BorderThickness="1" CornerRadius="18" Padding="28"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="14" Opacity="0.72"/></Border.Effect>
        <Grid><Grid.RowDefinitions><RowDefinition Height="140"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Grid.Row="0" ClipToBounds="True"><Border CornerRadius="13" Background="#15212B"><Grid><TextBlock Text="UHM" Foreground="#18DFFF32" FontSize="56" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding image}" Stretch="UniformToFill" Opacity="0.56"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#E80D141C" Offset="0"/><GradientStop Color="#7A0D141C" Offset="0.68"/><GradientStop Color="#C00D141C" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle></Grid></Border><DockPanel Margin="20,16"><Button x:Name="BtnCloseDetails" Style="{StaticResource GhostButton}" Content="×" FontSize="22" DockPanel.Dock="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom"><Border Background="#DFFF32" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right"><TextBlock x:Name="DetailCategory" Foreground="#0A0E10" FontSize="8" FontWeight="Bold"/></Border><TextBlock x:Name="DetailName" FontSize="27" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock x:Name="DetailAuthor" Foreground="#B4BEC7" Margin="0,5,0,0"/></StackPanel></DockPanel></Grid><ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="درباره مود" FontWeight="SemiBold"/><TextBlock x:Name="DetailDescription" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="22" Margin="0,10,0,18"/><TextBlock Text="دستورالعمل و وابستگی‌ها" FontWeight="SemiBold"/><TextBlock x:Name="DetailInstructions" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" LineHeight="21" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="2"><Border Background="#091016" CornerRadius="11" Padding="14"><StackPanel><DockPanel Margin="0,5"><TextBlock Text="نسخه" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailVersion" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="حجم" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailSize" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="آرشیو" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailArchive" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="CSP" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailCsp" DockPanel.Dock="Left"/></DockPanel><DockPanel Margin="0,5"><TextBlock Text="مسیر نصب" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DetailInstallRoot" DockPanel.Dock="Left" MaxWidth="180"/></DockPanel></StackPanel></Border><TextBlock Text="مقصد نصب" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,16,0,7"/><ComboBox x:Name="DetailTargetPath" DisplayMemberPath="display" SelectedValuePath="id"/><CheckBox x:Name="DetailAutoInstall" Content="پس از دانلود نصب شود" Margin="0,13,0,0"/></StackPanel></Grid></ScrollViewer><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="BtnOfficialPage" Grid.Column="0" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Content="بازکردن صفحه رسمی ↗"/><Button x:Name="BtnDetailDownload" Grid.Column="1" Style="{StaticResource BaseButton}" Content="فقط دانلود" Margin="6,0"/><Button x:Name="BtnDetailInstall" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="دانلود و نصب" Margin="6,0"/></Grid></Grid>
      </Border>
    </Grid>

    <!-- Busy overlay -->
    <Grid x:Name="BusyOverlay" Grid.ColumnSpan="2" Background="#B0020406" Visibility="Collapsed" Panel.ZIndex="100" FlowDirection="RightToLeft">
      <Border Width="410" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#101820" BorderBrush="#455563" BorderThickness="1" CornerRadius="16" Padding="28"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="12" Opacity="0.68"/></Border.Effect><StackPanel><Border Width="48" Height="48" CornerRadius="14" Background="#20DFFF32" HorizontalAlignment="Center"><TextBlock Text="U" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ProgressBar IsIndeterminate="True" Height="5" Margin="0,20,0,0"/><TextBlock x:Name="BusyTitle" Text="در حال پردازش…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0"/><TextBlock x:Name="BusyMessage" Text="لطفاً پنجره را نبندید." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
  </Grid>
</Window>
